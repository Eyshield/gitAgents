{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules"],
  "include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx", "global.d.ts"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["chrome"],
    "paths": {
      "@/*": ["./src/*"],
      "~*": ["./src/*"]
    }
  }
}
